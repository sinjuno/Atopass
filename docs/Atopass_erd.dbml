// Atopass(아토피 피부 기록 서비스) ERD
// dbdiagram.io 에 붙여넣어 사용한다. (DB: MySQL)
// 근거: API 명세서(Notion) 확정 사항

Project atopass {
  database_type: 'MySQL'
  Note: '아토피 피부 기록 서비스'
}

// ───────────── Enum ─────────────

Enum body_part {
  FACE
  NECK
  CHEST
  BACK
  ABDOMEN
  ARM
  HAND
  LEG
  FOOT
}

Enum symptom {
  PAIN      [note: '부위 고통 점수 (예전 증상별 점수는 skin_sign으로 옮김)']
}

Enum skin_sign {
  ERYTHEMA        [note: '홍반']
  EDEMA           [note: '부종/구진(결절)']
  OOZING          [note: '진물/딱지']
  EXCORIATION     [note: '긁은 자국(찰상)']
  LICHENIFICATION [note: '태선화']
  XEROSIS         [note: '건조증']
  ITCHING         [note: '가려움']
}

Enum outdoor_activity {
  LOW
  MEDIUM
  HIGH
}

Enum chat_mode {
  RECORD [note: '기록 입력']
  QUERY  [note: '기록 조회 및 분석']
}

Enum chat_role {
  USER
  ASSISTANT
}

// ───────────── 회원 / 인증 ─────────────

Table members {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  password varchar(255) [not null, note: '해시(BCrypt 등)로 저장']
  nickname varchar(50) [not null]
  llm_consented_at datetime [null, note: '챗봇(외부 LLM) 이용에 동의한 시각. 동의하지 않았거나 철회했으면 null']
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table refresh_tokens {
  id bigint [pk, increment]
  member_id bigint [not null]
  token_hash varchar(255) [not null, unique, note: '리프레시 토큰의 해시값. 원문은 저장하지 않는다']
  expires_at datetime [not null, note: '발급 후 14일']
  revoked boolean [not null, default: false, note: '로그아웃 시 true']
  created_at datetime [not null, default: `now()`]

  indexes {
    member_id
  }
}

// ───────────── 피부 기록 ─────────────

Table records {
  id bigint [pk, increment]
  member_id bigint [not null]
  record_date date [not null, note: '기록 날짜. 하루 1건']
  pain_index int [null, note: '고통 지수 0~10. 0은 없음이며 기록한 값. 미기록은 null. 주관적 강도이며 의료적 중증도가 아니다']
  sleep_hours decimal(3,1) [null, note: '미기록은 null. 수면 점수(1~5)는 저장하지 않고 수면 시간으로 계산한다']
  medication boolean [null, note: '약 복용 여부. 미기록은 null']
  alcohol boolean [null, note: '미기록은 null']
  outdoor_activity outdoor_activity [null, note: '미기록은 null']
  notes text [null, note: '특이사항 메모']
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (member_id, record_date) [unique, name: 'uk_records_member_date']
  }
}

Table skin_conditions {
  id bigint [pk, increment]
  record_id bigint [not null]
  body_part body_part [not null]

  indexes {
    (record_id, body_part) [unique, name: 'uk_skin_conditions_record_part']
  }

  Note: '기록 하나에 속한 신체 부위별 증상. 기록 삭제 시 함께 삭제'
}

Table symptom_scores {
  id bigint [pk, increment]
  skin_condition_id bigint [not null]
  symptom symptom [not null]
  score tinyint [not null, note: '0~10. 0은 증상 없음, 미기록은 행을 만들지 않는다.  주관적 강도이며 의료적 중증도가 아니다']

  indexes {
    (skin_condition_id, symptom) [unique, name: 'uk_symptom_scores_condition_symptom']
  }

  Note: '증상별 점수. 기록하지 않은 증상은 행을 만들지 않는다(null 대신 미존재)'
}

Table record_skin_signs {
  record_id bigint [not null]
  skin_sign skin_sign [not null, note: '오늘 나타난 증상. 없으면 행을 만들지 않는다']

  indexes {
    (record_id, skin_sign) [unique, name: 'uk_record_skin_signs']
  }

  Note: '하루 단위로 기록하는 나타난 증상(부위별 점수와 별개). 기록 삭제 시 함께 삭제'
}

Table photos {
  id bigint [pk, increment]
  record_id bigint [not null]
  original_file_name varchar(255) [not null]
  stored_file_name varchar(100) [not null, unique, note: 'UUID로 바꾼 저장 파일명']
  content_type varchar(50) [not null, note: 'image/jpeg, image/png']
  size_bytes bigint [not null, note: '최대 10MB']
  created_at datetime [not null, default: `now()`]

  indexes {
    record_id
  }

  Note: '파일은 서버 디스크(웹 루트 밖)에 저장. 기록당 최대 5장. 공개 URL 없이 인증 API로만 제공'
}

// ───────────── 챗봇 ─────────────

Table chatbot_sessions {
  id varchar(36) [pk, note: 'UUID']
  member_id bigint [not null]
  record_date date [not null, note: '날짜 하나당 세션 하나']
  mode chat_mode [not null]
  draft text [null, note: '확정 전 기록 초안(JSON 문자열)']
  fail_count int [not null, default: 0, note: '입력을 연속으로 해석하지 못한 횟수. 3회 이상이면 입력 예시 안내']
  confirmation_ready boolean [not null, default: false, note: '마지막 응답에서 확인(총정리) 단계로 넘어가도록 알렸는지. 새로고침 뒤에도 같은 값을 주기 위해 저장']
  closed boolean [not null, default: false, note: '기록을 저장하면 true. 닫힌 세션은 메시지를 받지 않는다']
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (member_id, record_date)
  }
}

Table chatbot_messages {
  id bigint [pk, increment]
  session_id varchar(36) [not null]
  role chat_role [not null]
  content text [not null]
  via_choice boolean [not null, default: false, note: '선택지 버튼으로 보낸 답. 이용 한도에 세지 않음']
  created_at datetime [not null, default: `now()`, note: '30일 뒤 삭제']

  indexes {
    (session_id, created_at)
  }
}

// ───────────── 진료 참고용 보고서 ─────────────

Table reports {
  id bigint [pk, increment]
  member_id bigint [not null]
  start_date date [not null]
  end_date date [not null]
  include_photos boolean [not null, default: false]
  file_name varchar(100) [null, note: 'PDF 파일명. 30일 뒤 파일 삭제 시 null (다운로드 때 다시 생성)']
  file_expires_at datetime [null]
  created_at datetime [not null, default: `now()`]

  indexes {
    member_id
  }

  Note: '메타데이터(기간, 옵션, 생성일)는 영구 저장하고 PDF 파일은 30일 뒤 삭제'
}

Table clinic_visits {
  id bigint [pk, increment]
  member_id bigint [not null]
  visit_date date [not null]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (member_id, visit_date) [unique, name: 'uk_clinic_visits_member_date']
  }

  Note: '피부과 재진 날짜. 지난 재진~다음 재진을 한 주기로 보고 홈 D-day, 그래프·보고서 기간으로 쓴다'
}

// ───────────── 관계 ─────────────

Ref: refresh_tokens.member_id > members.id [delete: cascade]
Ref: records.member_id > members.id [delete: cascade]
Ref: skin_conditions.record_id > records.id [delete: cascade]
Ref: symptom_scores.skin_condition_id > skin_conditions.id [delete: cascade]
Ref: record_skin_signs.record_id > records.id [delete: cascade]
Ref: photos.record_id > records.id [delete: cascade]
Ref: chatbot_sessions.member_id > members.id [delete: cascade]
Ref: chatbot_messages.session_id > chatbot_sessions.id [delete: cascade]
Ref: reports.member_id > members.id [delete: cascade]
Ref: clinic_visits.member_id > members.id [delete: cascade]

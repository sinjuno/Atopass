# 서버의 /opt/atopass/.env 로 복사해서 값을 채운다. 이 파일(.env)은 저장소에 올리지 않는다.

# 접속할 도메인 (https:// 없이). 예: atopass.example.com
DOMAIN=

# 아래 세 값은 직접 만든 긴 무작위 문자열을 쓴다.  생성: openssl rand -base64 48
JWT_SECRET=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 챗봇(Claude) 키. 비우면 챗봇만 503이고 나머지 기능은 동작한다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
CHATBOT_DAILY_LIMIT=100

# (선택) 자바 메모리. 서버 메모리가 4GB 이상이면 늘려도 된다. 기본값은 2GB 서버용.
# JAVA_OPTS=-Xms512m -Xmx1536m -XX:+UseSerialGC -Djava.awt.headless=true
